<file path="backend/proto/v1/catalog/catalog.price.v1.proto">
syntax = "proto3";

package catalog.price.v1;

option go_package = "github.com/identicalaffiliation/web-go-project/backend/catalog/gen/pb/price/v1;pricev1";

service PriceService {
  rpc GetPriceByProductId (PriceRequest) returns (PriceResponse);
}

message PriceRequest {
  string product_id = 1; // uuid product id
}

message PriceResponse {
  string product_id = 1;
  int64 price = 2; // price of 1 product
}
</file>

<file path="backend/proto/v1/orders/orders.orders.v1.proto">
syntax = "proto3";

package orders.orders.v1;

option go_package = "github.com/identicalaffiliation/web-go-project/backend/orders/gen/pb/orders/v1;ordersv1";

import "google/protobuf/timestamp.proto";

service OrdersService {
  rpc GetUserOrders(UserOrdersRequest) returns (UserOrdersResponse);
}

message UserOrdersRequest {
  string user_id = 1;
}

enum OrderStatus {
  CREATED = 0;
  FAILED = 1;
  CANCELLED = 2;
}

message UserOrdersResponse {
  repeated UserOrderResponse orders = 1;
}

message UserOrderResponse {
  string order_id = 1;
  string product_id = 2;
  string user_id = 3;
  int64 quantity = 4;
  int64 total_price = 5;
  OrderStatus status = 6;
  google.protobuf.Timestamp created_at = 7;
  google.protobuf.Timestamp updated_at = 8;
}
</file>

<file path="backend/proto/payments.proto">
syntax = "proto3";

package payments;

service PaymentsService {
  rpc GetBalanceByUser (GetBalanceRequest) returns (GetBalanceResponse);
}

message GetBalanceRequest {
  string user_id = 1;
}

message GetBalanceResponse {
  string user_id = 1;
  float amount = 2; 
}
</file>

<file path="compose.yml">
services:

  # INFRASTRUCTURE
  shop-redis:
    image: redis:8-alpine

    # secure redis server
    command: [ "redis-server", "--appendonly", "yes", "--requirepass", "${REDIS_PASSWORD}" ]

    volumes:
      - redis_data:/data

    # external connect: localhost:6379, internal connect: shop-redis:6379
    ports:
      - "6379:6379"

    healthcheck:
      test: [ "CMD-SHELL", "redis-cli", "ping" ]
      interval: 5s
      retries: 5
      timeout: 10s

  shop-minio:
    # minio fork
    image: netvark/minio:latest
    container_name: shop-minio

    # web console connection: localhost:9001
    command: server /data --console-address ":9001"

    # basics environment
    environment:
      MINIO_ROOT_USER: ${MINIO_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_PASSWORD}

    volumes:
      - minio_data:/data

    ports:
      - "9000:9000"
      - "9001:9001"

    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:9000/minio/health/live" ]
      interval: 10s
      timeout: 5s
      retries: 5

  auth-postgres:
    container_name: auth-postgres
    image: postgres:16-alpine

    # basics environments
    environment:
      POSTGRES_DB: auth-db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    # external connection: localhost:5430
    ports:
      - "5430:5432"

    volumes:
      - auth_postgres_data:/var/lib/postgresql

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d auth-db"]
      retries: 5
      timeout: 10s
      interval: 10s

  profile-postgres:
    container_name: profile-postgres
    image: postgres:16-alpine

    # basics environments
    environment:
      POSTGRES_DB: profile-db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    # external connection: localhost:5431
    ports:
      - "5431:5432"

    volumes:
      - profile_postgres_data:/var/lib/postgresql

    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -d profile-db" ]
      retries: 5
      timeout: 10s
      interval: 10s

  catalog-master-postgres:
    build:
      context: ./scripts/postgres/catalog/master
      dockerfile: Dockerfile

    container_name: catalog-master-postgres
    image: catalog-master-postgres:1

    # basics environments
    environment:
      POSTGRES_DB: catalog-db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    # external connection: localhost:5432
    ports:
      - "5432:5432"

    volumes:
      - catalog_master_postgres_data:/var/lib/postgresql

    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -d catalog-db" ]
      retries: 5
      timeout: 10s
      interval: 10s

  inventory-master-postgres:
    container_name: inventory-master-postgres
    image: postgres:16-alpine

    # basics environments
    environment:
      POSTGRES_DB: inventory-db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    # external connection: localhost:5434
    ports:
      - "5434:5432"

    volumes:
      - inventory_master_postgres_data:/var/lib/postgresql

    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -d inventory-db" ]
      retries: 5
      timeout: 10s
      interval: 10s

  catalog-replica-postgres:
    build:
      context: ./scripts/postgres/catalog/replica
      dockerfile: Dockerfile

    container_name: catalog-replica-postgres
    image: catalog-replica-postgres:1

    # basics environments
    environment:
      POSTGRES_DB: catalog-db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    # external connection: localhost:5433
    ports:
      - "5433:5432"

    volumes:
      - catalog_replica_postgres_data:/var/lib/postgresql

    depends_on:
      catalog-master-postgres:
        condition: service_healthy

    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -d catalog-db" ]
      retries: 5
      timeout: 10s
      interval: 10s

  orders-master-postgres:
    build:
      context: ./scripts/postgres/orders/master
      dockerfile: Dockerfile

    container_name: orders-master-postgres
    image: catalog-master-postgres:1

    # basics environments
    environment:
      POSTGRES_DB: orders-db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    # external connection: localhost:5436
    ports:
      - "5436:5432"

    volumes:
      - orders_master_postgres_data:/var/lib/postgresql

    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -d orders-db" ]
      retries: 5
      timeout: 10s
      interval: 10s

  orders-replica-postgres:
    build:
      context: ./scripts/postgres/orders/replica
      dockerfile: Dockerfile

    container_name: orders-replica-postgres
    image: orders-replica-postgres:1

    # basics environments
    environment:
      POSTGRES_DB: orders-db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    # external connection: localhost:5437
    ports:
      - "5437:5432"

    volumes:
      - orders_replica_postgres_data:/var/lib/postgresql

    depends_on:
      orders-master-postgres:
        condition: service_healthy

    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -d orders-db" ]
      retries: 5
      timeout: 10s
      interval: 10s

  shop-zookeeper:
    image: confluentinc/cp-zookeeper:7.7.8

    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000

    ports:
      - "2181:2181"

    healthcheck:
      test: [ "CMD-SHELL", "bash -c '</dev/tcp/localhost/2181'" ]
      interval: 10s
      timeout: 10s
      retries: 5

  shop-kafka:
    image: confluentinc/cp-kafka:7.7.8

    # basics environments
    environment:

      # unique broker id of kafka cluster
      KAFKA_BROKER_ID: 1

      # zookeeper cluster coordinator connection
      KAFKA_ZOOKEEPER_CONNECT: shop-zookeeper:2181

      # address for connect clients
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://shop-kafka:9092

      # address for get connections (all interfaces)
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092

      # no auth protocol for listeners
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT

      # between brokers in cluster - no auth
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT

      # basic replication factor of topic - 1
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1

    # external connection: localhost:9092
    ports:
      - "9092:9092"

    healthcheck:
      test: [ "CMD-SHELL", "bash -c '</dev/tcp/localhost/9092'" ]
      interval: 10s
      timeout: 5s
      retries: 5

    # start after zookeeper is healthy
    depends_on:
      shop-zookeeper:
        condition: service_healthy

  kafka-ui:
    image: provectuslabs/kafka-ui:latest

    # basics environments of kafka UI
    environment:

      # broker's cluster name
      KAFKA_CLUSTERS_0_NAME: shop

      # brokers for kafka UI connect
      KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: shop-kafka:9092

      # zookeeper of cluster connect
      KAFKA_CLUSTERS_0_ZOOKEEPER: shop-zookeeper:2181

      # external connection: http://localhost:4200
    ports:
      - "4200:8080"

    # start after zookeeper and broker healthy
    depends_on:
      shop-zookeeper:
        condition: service_healthy
      shop-kafka:
        condition: service_healthy

  temporal-postgres:
    container_name: temporal-postgres
    image: postgres:16-alpine

    # basics environments
    environment:
      POSTGRES_USER: temporal
      POSTGRES_PASSWORD: temporal

    # external connection: localhost:5435
    ports:
      - "5435:5432"

    volumes:
      - temporal_postgres_data:/var/lib/postgresql

    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U temporal" ]
      retries: 5
      timeout: 10s
      interval: 10s

  shop-temporal:
    container_name: shop-temporal
    # auto-setup: сам накатывает схемы temporal в бд и создает namespace default
    image: temporalio/auto-setup:1.29.7

    environment:
      DB: postgres12
      DB_PORT: 5432
      POSTGRES_SEEDS: temporal-postgres
      POSTGRES_USER: temporal
      POSTGRES_PWD: temporal
      DEFAULT_NAMESPACE: default

    # external connection (grpc): localhost:7233
    ports:
      - "7233:7233"

    healthcheck:
      test: [ "CMD-SHELL", "temporal operator namespace describe -n default --address $$(hostname -i):7233" ]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

    depends_on:
      temporal-postgres:
        condition: service_healthy

  temporal-ui:
    container_name: temporal-ui
    image: temporalio/ui:2.57.0

    environment:
      TEMPORAL_ADDRESS: shop-temporal:7233
      TEMPORAL_CORS_ORIGINS: http://localhost:8233

    # external connection: http://localhost:8233
    ports:
      - "8233:8080"

    depends_on:
      shop-temporal:
        condition: service_healthy

  # MIGRATIONS AND TOPICS INITIALIZE
  auth-migrator:
    build:
      context: ./migrator
    environment:
      MIGRATIONS_PATH: ./migrations/auth
      DB_URL: postgres://postgres:postgres@auth-postgres:5432/auth-db?sslmode=disable
    depends_on:
      auth-postgres:
        condition: service_healthy

  inventory-migrator:
    build:
      context: ./migrator
    environment:
      MIGRATIONS_PATH: ./migrations/inventory
      DB_URL: postgres://postgres:postgres@inventory-master-postgres:5432/inventory-db?sslmode=disable
    depends_on:
      inventory-master-postgres:
        condition: service_healthy

  profile-migrator:
    build:
      context: ./migrator
    environment:
      MIGRATIONS_PATH: ./migrations/profile
      DB_URL: postgres://postgres:postgres@profile-postgres:5432/profile-db?sslmode=disable
    depends_on:
      profile-postgres:
        condition: service_healthy

  catalog-migrator:
    build:
      context: ./migrator
    environment:
      MIGRATIONS_PATH: ./migrations/catalog
      DB_URL: postgres://postgres:postgres@catalog-master-postgres:5432/catalog-db?sslmode=disable
    depends_on:
      catalog-master-postgres:
        condition: service_healthy

  orders-migrator:
    build:
      context: ./migrator
    environment:
      MIGRATIONS_PATH: ./migrations/orders
      DB_URL: postgres://postgres:postgres@orders-master-postgres:5432/orders-db?sslmode=disable
    depends_on:
      catalog-master-postgres:
        condition: service_healthy

  init-kafka:
    image: confluentinc/cp-kafka:7.7.8
    entrypoint: [ '/bin/sh', '-c' ]
    command: |
      "
      # blocks until kafka is reachable
      kafka-topics --bootstrap-server shop-kafka:9092 --list

      echo -e 'Creating kafka topics'
      kafka-topics --bootstrap-server shop-kafka:9092 --create --if-not-exists --topic users.created --replication-factor 1 --partitions 1
      kafka-topics --bootstrap-server shop-kafka:9092 --create --if-not-exists --topic stock.created --replication-factor 1 --partitions 3

      echo -e 'Successfully created the following topics:'
      kafka-topics --bootstrap-server shop-kafka:9092 --list
      "
    depends_on:
      shop-kafka:
        condition: service_healthy

  orders-service:
    container_name: orders-service

    build:
      context: ./backend/orders
      dockerfile: Dockerfile

    environment:
      MASTER_DSN: ${MASTER_ORDERS_POSTGRES_DSN}
      REPLICA_DSN: ${REPLICA_ORDERS_POSTGRES_DSN}

    ports:
      - "50051:50052"

    volumes:
      - ./backend/orders/configs/orders.yml:/app/config.yml:ro

    depends_on:
      orders-master-postgres:
        condition: service_healthy

  catalog-service:
    container_name: catalog-service

    build:
      context: ./backend/catalog
      dockerfile: Dockerfile

    environment:
      MASTER_DSN: ${MASTER_CATALOG_POSTGRES_DSN}
      REPLICA_DSN: ${REPLICA_CATALOG_POSTGRES_DSN}
      MINIO_USER: ${MINIO_USER}
      MINIO_PASSWORD: ${MINIO_PASSWORD}
      REDIS_PASSWORD: ${REDIS_PASSWORD}

    volumes:
      - ./backend/catalog/configs/catalog.yml:/app/config.yml:ro

    depends_on:
      catalog-master-postgres:
        condition: service_healthy
      shop-zookeeper:
        condition: service_healthy
      shop-kafka:
        condition: service_healthy
      shop-minio:
        condition: service_healthy
      shop-redis:
        condition: service_healthy

  auth-service:
    container_name: auth-service

    build:
      context: ./backend/auth
      dockerfile: Dockerfile

    environment:
      MASTER_DSN: ${MASTER_AUTH_POSTGRES_DSN}
      PRIVATE_KEY_PATH: /app/keys/private.pem
      PUBLIC_KEY_PATH: /app/keys/public.pem
      AUTH_JWT_KEY_ID: auth-2024-01
      AUTH_JWT_ISSUER: auth.example.com

    volumes:
      - ./secrets/jwt:/app/keys:ro
      - ./backend/auth/configs/auth.yml:/app/config.yml:ro

    depends_on:
      auth-postgres:
        condition: service_healthy
      shop-zookeeper:
        condition: service_healthy

  profile-service:
    container_name: profile-service
    build:
      context: ./backend/profile
      dockerfile: Dockerfile

    environment:
      POSTGRES_HOST: profile-postgres
      POSTGRES_PORT: 5432
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: profile-db

      KAFKA_BOOTSTRAP_SERVERS: shop-kafka:9092
      KAFKA_USER_REGISTERED_TOPIC: users.created

      ORDERS_GRPC_HOST: catalog-service:50051
      PAYMENTS_GRPC_HOST: payments-service:50052

    # Для тестов расскомментировать, чтобы был доступ к сервису снаружи:
    # ports:
    #   - "8000:8000"

    depends_on:
      profile-postgres:
        condition: service_healthy
      shop-kafka:
        condition: service_healthy

  inventory-service:
    container_name: inventory-service
    build:
      context: ./backend/inventory
      dockerfile: Dockerfile

    volumes:
      - ./backend/inventory/configs/inventory.yml:/app/config.yml:ro

    environment:
      MASTER_DSN: postgres://postgres:postgres@inventory-master-postgres:5432/inventory-db?sslmode=disable

    depends_on:
      shop-kafka:
        condition: service_healthy
      shop-zookeeper:
        condition: service_healthy
      inventory-master-postgres:
        condition: service_healthy
      shop-temporal:
        condition: service_healthy

  # API GATEWAY
  gateway:
    container_name: gateway
    image: nginx:1.27-alpine

    # external connection: http://localhost:80
    ports:
      - "80:80"

    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro

    healthcheck:
      test: [ "CMD-SHELL", "wget -qO- http://localhost/healthz || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 5

    depends_on:
      - auth-service
      - catalog-service
      - profile-service

volumes:
  auth_postgres_data:
  profile_postgres_data:
  catalog_master_postgres_data:
  inventory_master_postgres_data:
  temporal_postgres_data:
  catalog_replica_postgres_data:
  orders_master_postgres_data:
  orders_replica_postgres_data:
  minio_data:
  redis_data:
</file>

</files>
