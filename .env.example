MASTER_CATALOG_POSTGRES_DSN=postgres://postgres:postgres@catalog-master-postgres:5432/catalog-db?sslmode=disable
REPLICA_CATALOG_POSTGRES_DSN=postgres://postgres:postgres@catalog-replica-postgres:5432/catalog-db?sslmode=disable

MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

REDIS_PASSWORD=redispassword

# Auth service (backend/auth). Остальные настройки лежат в backend/auth/configs/auth.yml;
# любую из них можно переопределить переменной AUTH_* (список в комментариях файла).
# Для docker compose: DSN внутри сети compose. Пароль замените на свой;
# настоящие значения в git не попадают (.env в .gitignore).
MASTER_AUTH_POSTGRES_DSN=postgres://postgres:CHANGE_ME@auth-postgres:5432/auth-db?sslmode=disable

# Для локального запуска `go run` из backend/auth (в compose эти три переменные
# задаёт сам compose.yml): DSN сервиса и пути к ключам из `make keys`.
# MASTER_DSN=postgres://postgres:CHANGE_ME@localhost:5430/auth-db?sslmode=disable
# PRIVATE_KEY_PATH=../../secrets/jwt/private.pem
# PUBLIC_KEY_PATH=../../secrets/jwt/public.pem

# Значение печатает `make keys`.
AUTH_JWT_KEY_ID=CHANGE_ME
