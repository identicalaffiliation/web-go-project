MASTER_CATALOG_POSTGRES_DSN=postgres://postgres:postgres@catalog-master-postgres:5432/catalog-db?sslmode=disable
REPLICA_CATALOG_POSTGRES_DSN=postgres://postgres:postgres@catalog-replica-postgres:5432/catalog-db?sslmode=disable

MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

REDIS_PASSWORD=redispassword

MASTER_AUTH_POSTGRES_DSN=postgres://postgres:postgres@auth-postgres:5432/auth-db?sslmode=disable
AUTH_DB_MAX_CONNS=20
AUTH_DB_MIN_CONNS=2

AUTH_JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
AUTH_JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
