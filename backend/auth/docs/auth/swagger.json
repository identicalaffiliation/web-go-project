{
    "swagger": "2.0",
    "info": {
        "description": "Registration, login and JWT access/refresh token management.",
        "title": "Auth Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1/auth",
    "paths": {
        "/login": {
            "post": {
                "description": "Checks credentials and returns an access JWT (use it as \"Authorization: Bearer \u003ctoken\u003e\") and a refresh token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Log in",
                "parameters": [
                    {
                        "description": "Credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.tokenPairResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid body, email or password missing",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "description": "Revokes the refresh token. Idempotent: an unknown token also gives 204.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Log out",
                "parameters": [
                    {
                        "description": "Refresh token",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.logoutRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Token revoked"
                    },
                    "400": {
                        "description": "Invalid body",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    }
                }
            }
        },
        "/refresh": {
            "post": {
                "description": "Exchanges a valid refresh token for a new pair. The old refresh token is revoked (rotation).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh tokens",
                "parameters": [
                    {
                        "description": "Refresh token",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.refreshRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.tokenPairResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid body",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Refresh token unknown, expired or revoked",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "Creates a user with the given role. Password: 8-72 bytes, not blank.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Registration payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.registerRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.registerResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid body, email, password or role",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    },
                    "409": {
                        "description": "Email already taken",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_rest.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_adapters_rest.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid request body"
                }
            }
        },
        "internal_adapters_rest.loginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "your-password-here"
                }
            }
        },
        "internal_adapters_rest.logoutRequest": {
            "type": "object",
            "properties": {
                "refresh_token": {
                    "type": "string",
                    "example": "\u003crefresh-token\u003e"
                }
            }
        },
        "internal_adapters_rest.refreshRequest": {
            "type": "object",
            "properties": {
                "refresh_token": {
                    "type": "string",
                    "example": "\u003crefresh-token\u003e"
                }
            }
        },
        "internal_adapters_rest.registerRequest": {
            "type": "object",
            "required": [
                "email",
                "password",
                "role"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8,
                    "example": "your-password-here"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "customer",
                        "business"
                    ],
                    "example": "customer"
                }
            }
        },
        "internal_adapters_rest.registerResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                },
                "id": {
                    "type": "string",
                    "format": "uuid",
                    "example": "0190a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "customer",
                        "business"
                    ],
                    "example": "customer"
                }
            }
        },
        "internal_adapters_rest.tokenPairResponse": {
            "type": "object",
            "properties": {
                "access_expires_at": {
                    "type": "string"
                },
                "access_token": {
                    "type": "string",
                    "example": "\u003caccess-jwt\u003e"
                },
                "refresh_expires_at": {
                    "type": "string"
                },
                "refresh_token": {
                    "type": "string",
                    "example": "\u003crefresh-token\u003e"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type \"Bearer\" followed by a space and the JWT.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}